---
const statusIssueEndpoint = "/_data/current";
const statusIssueFallbackEndpoint =
  "https://api.github.com/repos/andrewmuratov/gapwise-status/issues/1";
---

<section
  class="gapwise-status"
  data-gapwise-status
  data-status-endpoint={statusIssueEndpoint}
  data-status-fallback-endpoint={statusIssueFallbackEndpoint}
  aria-live="polite"
>
  <div class="status-summary status-summary--unknown" data-status-summary>
    <div class="status-summary__icon" data-summary-icon aria-hidden="true">●</div>
    <div>
      <p class="status-summary__eyebrow">Gapwise status</p>
      <h2 data-summary-title>Loading current status…</h2>
      <p data-summary-message>Fetching the latest production check.</p>
    </div>
  </div>

  <div class="status-meta" aria-label="Status freshness">
    <span class="status-live-dot" data-status-live-dot aria-hidden="true"></span>
    <span data-last-updated>Hourly checks · waiting for latest result</span>
  </div>

  <section class="status-incident" data-active-incident hidden>
    <div class="status-incident__bar" aria-hidden="true"></div>
    <div class="status-incident__body">
      <div class="status-incident__label" data-incident-label>Service incident</div>
      <h3 data-incident-title>Service disruption detected</h3>
      <p data-incident-message></p>
      <p class="status-incident__meta" data-incident-meta></p>
    </div>
  </section>

  <section class="status-system-card" aria-labelledby="system-status-heading">
    <div class="status-system-card__header">
      <div>
        <p class="status-section-kicker">Production</p>
        <h2 id="system-status-heading">System status</h2>
      </div>
      <span class="status-hourly-badge" data-hourly-badge>Checked hourly</span>
    </div>
    <div class="status-groups" data-status-groups>
      <div class="status-loading-row">Loading service checks…</div>
    </div>
  </section>

  <div class="status-actions">
    <a class="status-history-button" href="/history/">
      <span aria-hidden="true">◷</span>
      View history
    </a>
  </div>

  <div class="status-disclaimer">
    Automated probes run approximately hourly. Authentication/sync and transactional email are
    operator-maintained. This page is not continuous monitoring or a contractual SLA.
  </div>

  <details class="status-about">
    <summary>About this status page</summary>
    <div class="status-about__body">
      <p>
        Automated checks cover Gapwise-owned application surfaces and direct production dependencies
        that can be tested safely outside a private user session. University of Toronto systems and
        other upstream services remain outside Gapwise's control.
      </p>
      <p>
        If a user-facing problem persists after a retry, email <a href="mailto:support@gapwise.ca">support@gapwise.ca</a>.
        Suspected vulnerabilities should be reported privately to <a href="mailto:security@gapwise.ca">security@gapwise.ca</a>.
      </p>
    </div>
  </details>
</section>

<script is:inline>
  const STATUS_MARKER_START = "<!-- GAPWISE_STATUS_JSON_START -->";
  const STATUS_MARKER_END = "<!-- GAPWISE_STATUS_JSON_END -->";
  const STATUS_RANK = { operational: 0, unknown: 1, degraded: 2, outage: 3 };
  const STATUS_STALE_AFTER_MS = 2.5 * 60 * 60 * 1000;

  const escapeHtml = (value) =>
    String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  const normalizeStatus = (value) =>
    Object.hasOwn(STATUS_RANK, value) ? value : "unknown";

  const statusLabel = (status) => ({
    operational: "Operational",
    degraded: "Degraded performance",
    outage: "Outage",
    unknown: "Unknown",
  })[normalizeStatus(status)];

  const statusIcon = (status) => ({
    operational: "✓",
    degraded: "!",
    outage: "×",
    unknown: "?",
  })[normalizeStatus(status)];

  const worstStatus = (services, fallback = "operational") =>
    services.reduce((worst, service) => {
      const candidate = normalizeStatus(service.status);
      return STATUS_RANK[candidate] > STATUS_RANK[worst] ? candidate : worst;
    }, fallback);

  const extractStatusData = (body) => {
    const start = body.indexOf(STATUS_MARKER_START);
    const end = body.indexOf(STATUS_MARKER_END);
    if (start === -1 || end === -1 || end <= start) return null;
    return JSON.parse(body.slice(start + STATUS_MARKER_START.length, end).trim());
  };

  const parseTime = (value) => {
    if (!value) return null;
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? null : date;
  };

  const formatCheckTime = (value) => {
    const date = parseTime(value);
    if (!date) return "Latest check time unavailable";
    return `Last checked ${new Intl.DateTimeFormat(undefined, {
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
      timeZoneName: "short",
    }).format(date)}`;
  };

  const formatOperatorTime = (value) => {
    const date = parseTime(value);
    if (!date) return null;
    return new Intl.DateTimeFormat(undefined, {
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    }).format(date);
  };

  const fetchIssue = async (endpoints) => {
    let lastError;
    for (const endpoint of endpoints.filter(Boolean)) {
      try {
        const response = await fetch(new URL(endpoint, window.location.origin), {
          headers: { Accept: "application/vnd.github+json" },
        });
        if (!response.ok) throw new Error(`Status source returned ${response.status}`);
        const issue = await response.json();
        if (!issue || typeof issue.body !== "string") {
          throw new Error("Status source returned invalid data");
        }
        return issue;
      } catch (error) {
        lastError = error;
      }
    }
    throw lastError || new Error("No status source is configured");
  };

  document.querySelectorAll("[data-gapwise-status]").forEach(async (root) => {
    const endpoints = [root.dataset.statusEndpoint, root.dataset.statusFallbackEndpoint];
    const summary = root.querySelector("[data-status-summary]");
    const summaryIcon = root.querySelector("[data-summary-icon]");
    const summaryTitle = root.querySelector("[data-summary-title]");
    const summaryMessage = root.querySelector("[data-summary-message]");
    const lastUpdated = root.querySelector("[data-last-updated]");
    const liveDot = root.querySelector("[data-status-live-dot]");
    const hourlyBadge = root.querySelector("[data-hourly-badge]");
    const groupsRoot = root.querySelector("[data-status-groups]");
    const incident = root.querySelector("[data-active-incident]");
    const incidentLabel = root.querySelector("[data-incident-label]");
    const incidentTitle = root.querySelector("[data-incident-title]");
    const incidentMessage = root.querySelector("[data-incident-message]");
    const incidentMeta = root.querySelector("[data-incident-meta]");

    try {
      const issue = await fetchIssue(endpoints);
      const data = extractStatusData(issue.body);
      if (!data || !Array.isArray(data.groups)) throw new Error("Status payload is missing");

      const services = data.groups.flatMap((group) =>
        Array.isArray(group.services) ? group.services : [],
      );
      const recordedStatus = normalizeStatus(data.summary?.status);
      const checkedAt = parseTime(data.generatedAt);
      const hasCompletedCheck = Boolean(checkedAt);
      const isStale = Boolean(checkedAt && Date.now() - checkedAt.getTime() > STATUS_STALE_AFTER_MS);
      const manualAffected = services.filter(
        (service) =>
          service.monitoring === "manual" &&
          ["degraded", "outage"].includes(normalizeStatus(service.status)),
      );
      const manualIncidentStatus =
        manualAffected.length > 0 ? worstStatus(manualAffected, "degraded") : null;
      const presentationStatus = manualIncidentStatus || (isStale ? "unknown" : recordedStatus);

      summary.className = `status-summary status-summary--${presentationStatus}`;
      summaryIcon.textContent = statusIcon(presentationStatus);
      liveDot.className = `status-live-dot status-live-dot--${presentationStatus}`;
      hourlyBadge.className = isStale
        ? "status-hourly-badge status-hourly-badge--warning"
        : "status-hourly-badge";
      hourlyBadge.textContent = isStale ? "Monitoring delayed" : "Checked hourly";

      if (manualIncidentStatus && (!hasCompletedCheck || isStale)) {
        summaryTitle.textContent =
          manualIncidentStatus === "outage"
            ? "A Gapwise service is currently unavailable"
            : "We’re currently experiencing issues";
        const suffix = isStale
          ? " Automated monitoring is also delayed."
          : " Automated monitoring has not completed yet.";
        summaryMessage.textContent =
          `${data.summary?.message || "An operator-maintained service is reporting an incident."}${suffix}`;
        lastUpdated.textContent = hasCompletedCheck
          ? `${formatCheckTime(data.generatedAt)} · monitoring delayed`
          : "No completed automated check yet · operator incident active";
      } else if (!hasCompletedCheck) {
        summaryTitle.textContent = "Waiting for the first production check";
        summaryMessage.textContent = data.summary?.message || "The hourly monitor is initializing.";
        lastUpdated.textContent = "No completed automated check yet · updates hourly";
      } else if (isStale) {
        summaryTitle.textContent = "Status monitoring is delayed";
        summaryMessage.textContent =
          "The latest automated result is older than expected. Service states below are the last known results.";
        lastUpdated.textContent = `${formatCheckTime(data.generatedAt)} · monitoring delayed`;
      } else {
        summaryTitle.textContent =
          recordedStatus === "operational"
            ? "All monitored systems are operational"
            : recordedStatus === "degraded"
              ? "We’re currently experiencing issues"
              : recordedStatus === "outage"
                ? "A Gapwise service is currently unavailable"
                : "Current status is temporarily unavailable";
        summaryMessage.textContent =
          data.summary?.message || "See the service list below for the latest check results.";
        lastUpdated.textContent = `${formatCheckTime(data.generatedAt)} · updates hourly`;
      }

      incident.hidden = true;
      incident.classList.remove("status-incident--degraded", "status-incident--outage");
      const affected = services.filter((service) => {
        const state = normalizeStatus(service.status);
        return ["degraded", "outage"].includes(state) &&
          (service.monitoring === "manual" || !isStale);
      });

      if (affected.length > 0) {
        incident.hidden = false;
        const worst = worstStatus(affected, "degraded");
        const manualCount = affected.filter((service) => service.monitoring === "manual").length;
        const automaticCount = affected.length - manualCount;
        incident.classList.add(`status-incident--${worst}`);
        incidentLabel.textContent = worst === "outage" ? "Service outage" : "Service incident";
        incidentTitle.textContent = affected.length === 1
          ? `${affected[0].name} is reporting issues`
          : `${affected.length} services are reporting issues`;
        incidentMessage.textContent = manualCount > 0 && automaticCount === 0
          ? "This state was reported by the Gapwise operator. Automated probes continue independently."
          : manualCount > 0
            ? "The latest status includes operator-reported and automated issues. We’ll continue checking and update this page when the state changes."
            : "The latest hourly production probes did not pass cleanly. We’ll continue checking and update this page when the result changes.";
        incidentMeta.textContent = `Affects ${affected.map((service) => service.name).join(", ")}`;
      }

      groupsRoot.innerHTML = data.groups.map((group) => {
        const groupServices = Array.isArray(group.services) ? group.services : [];
        const rollup = worstStatus(groupServices);
        const shouldOpen = groupServices.some((service) => {
          const state = normalizeStatus(service.status);
          return ["degraded", "outage"].includes(state) &&
            (service.monitoring === "manual" || !isStale);
        });

        const rows = groupServices.map((service) => {
          const state = normalizeStatus(service.status);
          let monitoring;
          if (service.monitoring === "automatic") {
            monitoring = isStale ? "Last known hourly probe" : "Hourly probe";
          } else {
            const operatorTime = formatOperatorTime(service.checkedAt);
            monitoring = operatorTime
              ? `Operator updated ${operatorTime}`
              : "Operator-maintained · confirmation time unavailable";
          }
          const detail = service.detail ? ` · ${escapeHtml(service.detail)}` : "";
          return `
            <div class="status-service-row">
              <span class="status-icon status-icon--${escapeHtml(state)}" aria-hidden="true">${statusIcon(state)}</span>
              <div class="status-service-row__main">
                <span class="status-service-row__name">${escapeHtml(service.name)}</span>
                <span class="status-service-row__meta">${escapeHtml(monitoring)}${detail}</span>
              </div>
              <span class="status-service-row__state">${escapeHtml(statusLabel(state))}</span>
            </div>`;
        }).join("");

        return `
          <details class="status-group" ${shouldOpen ? "open" : ""}>
            <summary class="status-group__summary">
              <span class="status-icon status-icon--${escapeHtml(rollup)}" aria-hidden="true">${statusIcon(rollup)}</span>
              <span class="status-group__name">${escapeHtml(group.name)}</span>
              <span class="status-group__state">${escapeHtml(statusLabel(rollup))}</span>
              <span class="status-chevron" aria-hidden="true">⌄</span>
            </summary>
            <div class="status-service-list">${rows}</div>
          </details>`;
      }).join("");
    } catch (error) {
      summary.className = "status-summary status-summary--unknown";
      summaryIcon.textContent = "?";
      liveDot.className = "status-live-dot";
      hourlyBadge.className = "status-hourly-badge status-hourly-badge--warning";
      hourlyBadge.textContent = "Status unavailable";
      incident.hidden = true;
      summaryTitle.textContent = "Live status data is temporarily unavailable";
      summaryMessage.textContent = "The latest status record could not be loaded.";
      lastUpdated.textContent = "Status source unavailable · retry shortly";
      groupsRoot.innerHTML = `
        <div class="status-loading-row status-loading-row--error">
          Could not load the current service record. This does not by itself mean Gapwise is down.
        </div>`;
      console.error("Gapwise status dashboard:", error);
    }
  });
</script>
